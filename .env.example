# --- Local development (all optional; defaults work with SQLite) ---
DATABASE_URL=sqlite:///./app.db
# Production: postgresql://user:password@host:5432/dbname

# dev | test | staging | production. "production" refuses to start with unsafe settings (see below).
APP_ENV=dev

# Phones (10 digits, comma separated) that log in as admin through the same OTP flow
ADMIN_PHONES=

# --- Must be set in staging/production (store in the host's secret manager, never in git) ---
# JWT_SECRET=<at least 32 random characters, e.g. `openssl rand -hex 32`>
# PAYMENT_WEBHOOK_SECRET=<shared secret from the payment aggregator>
# OTP_SENDER=console        # console only logs the code. Production needs a real SMS sender (see docs/03-architecture.md)
# PAYMENT_PROVIDER=fake     # fake only simulates deposits. Production needs a real aggregator implementation

# --- Tuning ---
# DEPOSIT_RUPEES=1000
# SUCCESS_FEE_RUPEES=6000
# JWT_TTL_MINUTES=120
# OTP_TTL_SECONDS=300
# RATE_LIMIT_PER_MINUTE=120
# TRUST_PROXY=true          # honour X-Forwarded-For (set when behind Render/another proxy)
# LOG_LEVEL=INFO
